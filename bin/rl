def load_catalog():
    f = RL / "sims" / "catalog.yaml"
    if not f.exists():
        die("sims/catalog.yaml がありません")
    with f.open() as fh:
        return (YAML(typ="safe").load(fh) or {}).get("tools") or {}


def this_platform():
    """手元で動くプラットフォーム（any / cuda / rtx）の集合。"""
    ok = {"any"}
    if which("nvidia-smi"):
        ok.add("cuda")
        r = subprocess.run(["nvidia-smi", "--query-gpu=name", "--format=csv,noheader"], capture_output=True, text=True)
        if "RTX" in r.stdout or "L40" in r.stdout:
            ok.add("rtx")
    return ok


def sim_lock_path(proj: Path) -> Path:
    return proj / "sims.lock.yaml"


def load_sim_lock_all(proj: Path) -> dict:
    f = sim_lock_path(proj)
    return (load(f) or {}) if f.exists() else {}


def load_sim_lock(proj: Path) -> dict:
    return load_sim_lock_all(proj).get("tools") or {}


def save_sim_lock(proj: Path, tools: dict, worker: dict | None = None) -> None:
    f = sim_lock_path(proj)
    data = {"note": "rl sim setup が書く。入れた道具の正確な版（commit）を残し、同じ環境を立て直せるようにする",
            "tools": tools}
    worker = worker if worker is not None else load_sim_lock_all(proj).get("worker")
    if worker:
        data["worker"] = worker
    dump(data, f)


def py_version_of(py: Path) -> str:
    r = subprocess.run([str(py), "-c", "import platform; print(platform.python_version())"], capture_output=True, text=True)
    return r.stdout.strip()


def tool_venv(proj: Path, name: str, t: dict) -> Path:
    """道具を入れる venv。catalog の python（例 "3.12"）がプロジェクトの .venv と違えば、その道具だけ別の venv（.cache/venvs/<名前>）。"""
    main = proj / ".venv"
    want = str(t.get("python") or "")
    if not want:
        return main
    if not (main / "bin" / "python").exists():
        return main
    have = py_version_of(main / "bin" / "python")
    return main if (have == want or have.startswith(want + ".")) else proj / ".cache" / "venvs" / name


def ensure_venv(venv: Path, python: str = "3.11") -> Path:
    py = venv / "bin" / "python"
    if not py.exists():
        venv.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["uv", "venv", str(venv), "--python", python], check=True)
    return py


def proj_python(proj: Path) -> Path:
    return ensure_venv(proj / ".venv", "3.11")


def lock_venv(proj: Path, entry: dict) -> Path:
    return proj / (entry.get("venv") or ".venv")


def pkg_names(specs) -> list:
    names = []
    for sp in specs:
        n = sp
        for sep in ("[", ">", "<", "=", "!", "~", " "):
            n = n.split(sep)[0]
        names.append(n)
    return names


VERSIONS_CODE = "import importlib.metadata as m, json\nout={}\nfor n in %r:\n    try: out[n]=m.version(n)\n    except Exception: out[n]=None\nprint(json.dumps(out))"


def py_versions(py: Path, specs) -> dict:
    names = pkg_names(specs)
    r = subprocess.run([str(py), "-c", VERSIONS_CODE % names], capture_output=True, text=True)
    try:
        return json.loads(r.stdout.strip().splitlines()[-1])
    except (json.JSONDecodeError, IndexError):
        return {n: None for n in names}


def git_fetch_pinned(repo: str, ref: str, dest: Path) -> str:
    if (dest / ".git").exists():
        r = subprocess.run(["git", "-C", str(dest), "rev-parse", "HEAD"], capture_output=True, text=True)
        return r.stdout.strip()
    dest.mkdir(parents=True, exist_ok=True)
    subprocess.run(["git", "init", "-q"], cwd=dest, check=True)
    subprocess.run(["git", "remote", "add", "origin", repo], cwd=dest, check=True)
    subprocess.run(["git", "fetch", "-q", "--depth", "1", "origin", ref], cwd=dest, check=True)
    subprocess.run(["git", "checkout", "-q", "FETCH_HEAD"], cwd=dest, check=True)
    r = subprocess.run(["git", "-C", str(dest), "rev-parse", "HEAD"], capture_output=True, text=True)
    return r.stdout.strip()


def sim_setup_one(proj: Path, name: str, t: dict, lock: dict) -> None:
    kind = t.get("kind")
    plat = this_platform()
    if t.get("platform", "any") not in plat and kind != "remote":
        print(f"✗ {name}: この計算機では動きません（{t.get('platform')} が要る）")
        return
    if kind == "py":
        specs = t["spec"] if isinstance(t["spec"], list) else [t["spec"]]
        if not (proj / ".venv" / "bin" / "python").exists():
            proj_python(proj)
        venv = tool_venv(proj, name, t)
        py = ensure_venv(venv, str(t.get("python") or "3.11"))
        subprocess.run(["uv", "pip", "install", "--python", str(py), *specs], check=True)
        e = {"kind": "py", "packages": py_versions(py, specs), "python": py_version_of(py), "installed": now()}
        if venv != proj / ".venv":
            e["venv"] = str(venv.relative_to(proj))
        lock[name] = e
        print(f"✓ {name}: " + ", ".join(f"{k} {v}" for k, v in e["packages"].items()) + (f"（別の venv {e['venv']}、Python {e['python']}）" if e.get("venv") else ""))
    elif kind == "git":
        dest = SIM_CACHE / name / t["ref"]
        sha = git_fetch_pinned(t["repo"], t["ref"], dest)
        lock[name] = {"kind": "git", "repo": t["repo"], "commit": sha, "path": str(dest), "installed": now()}
        print(f"✓ {name}: {sha[:12]} を {dest} に取り込み")
        if t.get("build"):
            print(f"  ビルドの注意: {t['build']}")
    elif kind == "cli":
        exe = t.get("check", "").split()[0] if t.get("check") else None
        if not (exe and which(exe)):
            subprocess.run(t["install"], shell=True, check=True)
        r = subprocess.run(t["check"], shell=True, capture_output=True, text=True)
        ver = (r.stdout or r.stderr).strip().splitlines()[-1] if (r.stdout or r.stderr).strip() else "?"
        lock[name] = {"kind": "cli", "version": ver, "installed": now()}
        print(f"✓ {name}: {ver}")
    elif kind == "remote":
        src = RL / t["template"]
        dst = proj / "configs" / "sky" / src.name
        dst.parent.mkdir(parents=True, exist_ok=True)
        if not dst.exists():
            shutil.copy(src, dst)
        lock[name] = {"kind": "remote", "template": str(dst.relative_to(proj)), "gpu": t.get("gpu"), "installed": now()}
        for k in ("repo", "ref", "spec"):
            if t.get(k):
                lock[name][k] = t[k]
        print(f"✓ {name}: 手元では動かないので、借りた GPU で立てる設定を {dst.relative_to(proj)} に置きました")
        print(f"  使うとき（G2 の承認のあと）: rl gpu up {proj.name} {dst.relative_to(proj)} --hours H --usd-per-hour X")
        if t.get("license"):
            print(f"  ライセンス: {t['license']}")
    else:
        die(f"{name}: kind が不明 {kind}")


def sim_check_one(proj: Path, name: str, t: dict, entry: dict) -> bool:
    kind = entry.get("kind")
    if kind == "py":
        py = lock_venv(proj, entry) / "bin" / "python"
        if not py.exists():
            print(f"✗ {name}: {entry.get('venv') or '.venv'} がありません（rl sim setup {name}）"); return False
        specs = t["spec"] if isinstance(t["spec"], list) else [t["spec"]]
        now_v = py_versions(py, specs)
        drift = {k: (v, now_v.get(k)) for k, v in (entry.get("packages") or {}).items() if now_v.get(k) != v}
        if drift:
            print(f"✗ {name}: 版が記録と違います {drift}"); return False
        if t.get("smoke") in SMOKE:
            r = subprocess.run([str(py), "-c", SMOKE[t["smoke"]]], capture_output=True, text=True)
            if r.returncode != 0:
                print(f"✗ {name}: 動作の確認に失敗\n{(r.stderr or r.stdout)[-800:]}"); return False
            print(f"✓ {name}: {r.stdout.strip().splitlines()[-1]}")
        else:
            print(f"✓ {name}: " + ", ".join(f"{k} {v}" for k, v in now_v.items()))
        return True
    if kind == "git":
        path = Path(entry.get("path", ""))
        if not (path / ".git").exists():
            print(f"✗ {name}: {path} がありません（rl sim setup {name}）"); return False
        r = subprocess.run(["git", "-C", str(path), "rev-parse", "HEAD"], capture_output=True, text=True)
        dirty = subprocess.run(["git", "-C", str(path), "status", "--porcelain"], capture_output=True, text=True).stdout.strip()
        ok = r.stdout.strip() == entry.get("commit")
        print(f"{'✓' if ok else '✗'} {name}: {r.stdout.strip()[:12]}" + ("" if ok else f"（記録は {entry.get('commit', '')[:12]}）") + ("  ⚠ 手を入れた差分あり" if dirty else ""))
        return ok
    if kind == "cli":
        r = subprocess.run(t["check"], shell=True, capture_output=True, text=True)
        good = r.returncode == 0
        print(f"{'✓' if good else '✗'} {name}: {(r.stdout or r.stderr).strip()[:80]}")
        return good
    if kind == "remote":
        good = (proj / entry.get("template", "")).exists()
        print(f"{'✓' if good else '✗'} {name}: 借りた GPU で立てる設定 {entry.get('template')}" + ("" if which("sky") else "（SkyPilot が未導入: rl sim setup skypilot）"))
        return good
    print(f"✗ {name}: kind が不明"); return False


# ---- dev-worker（offload の Worker。2 台目の Apple シリコンの Mac）
def uv_version() -> str:
    r = subprocess.run(["uv", "--version"], capture_output=True, text=True)
    parts = r.stdout.split()
    return parts[1] if len(parts) > 1 else ""


def worker_script(body: str) -> str:
    """Worker で走らせる bash。uv が無ければ手元と同じ版を ~/.local/share/rl/uv に入れる（brew は触らない）。"""
    uv = uv_version()
    return f"""set -euo pipefail
UV="$(command -v uv || true)"
if [ -z "$UV" ]; then
  UV="$HOME/.local/share/rl/uv/bin/uv"
  if [ ! -x "$UV" ]; then
    echo "rl: Worker に uv が無いので $HOME/.local/share/rl/uv に uv=={uv} を入れます" >&2
    python3 -m venv "$HOME/.local/share/rl/uv" && "$HOME/.local/share/rl/uv/bin/pip" install -q "uv=={uv}"
  fi
fi
{body}
"""


def worker_exec(proj: Path, body: str, capture: bool = False) -> subprocess.CompletedProcess:
    """offload run で、Worker のプロジェクトのミラー（~/offload/<名前>）の一番上で bash を走らせる。
    スクリプトは base64 で渡す（offload の引数の読み替えと引用符の問題を避ける）。"""
    if not which("offload"):
        die("offload がありません（~/.offload/README.md）")
    b64 = base64.b64encode(worker_script(body).encode()).decode()
    cmd = ["offload", "run", "--", f"echo {b64} | base64 -d | bash"]
    return subprocess.run(cmd, cwd=proj, capture_output=capture, text=True)


def worker_json(r: subprocess.CompletedProcess) -> dict:
    for line in reversed((r.stdout or "").splitlines()):
        if line.startswith("RLJSON "):
            return json.loads(line[len("RLJSON "):])
    return {}


def worker_setup(proj: Path, names: list, cat: dict, lock: dict) -> None:
    allw = load_sim_lock_all(proj).get("worker") or {}
    wtools = allw.get("tools") or {}
    body, plan = [], []
    for name in names:
        t, e = cat.get(name, {}), lock.get(name)
        if not e:
            die(f"{name} は手元の sims.lock.yaml にありません。先に手元で rl sim setup {name}（Worker は手元と同じ版を入れる）")
        if e["kind"] == "py":
            venv = e.get("venv") or ".venv"
            pyv = e.get("python") or py_version_of(lock_venv(proj, e) / "bin" / "python")
            pins = [f"{k}=={v}" for k, v in (e.get("packages") or {}).items() if v]
            q = " ".join(shlex.quote(p) for p in pins)
            report = ("import importlib.metadata as m, json, platform\nout = {}\n"
                      f"for n in {list((e.get('packages') or {}).keys())!r}:\n"
                      "    try: out[n] = m.version(n)\n    except Exception: out[n] = None\n"
                      f"print('RLJSON ' + json.dumps({{'tool': {name!r}, 'python': platform.python_version(), 'packages': out}}))\n")
            b64 = base64.b64encode(report.encode()).decode()
            body.append(f"""[ -x {venv}/bin/python ] || "$UV" venv -q --python {pyv} {venv}
"$UV" pip install -q --python {venv}/bin/python {q}
echo {b64} | base64 -d | {venv}/bin/python -
""")
            plan.append((name, "py", venv))
        elif e["kind"] == "git":
            rel = f".cache/sims/{name}/{e['commit']}"
            body.append(f"""if [ ! -d {rel}/.git ]; then mkdir -p {rel} && git -C {rel} init -q && git -C {rel} remote add origin {shlex.quote(e['repo'])} && git -C {rel} fetch -q --depth 1 origin {e['commit']} && git -C {rel} checkout -q FETCH_HEAD; fi
echo "RLJSON {{\\"tool\\": \\"{name}\\", \\"commit\\": \\"$(git -C {rel} rev-parse HEAD)\\", \\"path\\": \\"{rel}\\"}}" """)
            plan.append((name, "git", rel))
        else:
            print(f"- {name}: {e['kind']} は Worker に入れません（{'借りた GPU で使う' if e['kind'] == 'remote' else '手元のコマンド'}）")
    if not body:
        return
    # 1 つずつ走らせて、結果（RLJSON の行）を集める
    for (name, kind, where), b in zip(plan, body):
        print(f"→ Worker に {name} を入れます（{where}）")
        r = worker_exec(proj, b, capture=True)
        sys.stderr.write((r.stderr or "")[-1500:] if r.returncode else "")
        res = worker_json(r)
        if r.returncode != 0 or not res:
            print(f"✗ {name}: Worker での導入に失敗（終了コード {r.returncode}）\n{(r.stdout or '')[-800:]}")
            continue
        if kind == "py":
            want = lock[name].get("packages") or {}
            ok = res["packages"] == want
            wtools[name] = {"kind": "py", "venv": where, "python": res["python"], "packages": res["packages"], "installed": now()}
            print(f"{'✓' if ok else '✗'} {name}: " + ", ".join(f"{k} {v}" for k, v in res["packages"].items()) + f"（Python {res['python']}）" + ("" if ok else f"  手元と違う {want}"))
        else:
            ok = res["commit"] == lock[name]["commit"]
            wtools[name] = {"kind": "git", "repo": lock[name]["repo"], "commit": res["commit"], "path": where, "installed": now()}
            print(f"{'✓' if ok else '✗'} {name}: {res['commit'][:12]}（{where}）")
    allw.update({"host": WORKER_HOST, "via": "offload run（~/offload/<プロジェクト名>--<hash> のミラー。.venv と .cache は同期されず Worker 側に残る）", "tools": wtools})
    save_sim_lock(proj, lock, allw)


def worker_check(proj: Path, cat: dict, lock: dict) -> bool:
    w = (load_sim_lock_all(proj).get("worker") or {}).get("tools") or {}
    if not w:
        print("Worker にはまだ何も入っていません（rl sim setup <tool> --worker）"); return True
    lines = []
    for name, e in w.items():
        t = cat.get(name, {})
        if e["kind"] == "py":
            v = e.get("venv") or ".venv"
            code = VERSIONS_CODE % list((e.get("packages") or {}).keys())
            lines.append(f'echo "RLV {name} $({v}/bin/python -c {shlex.quote(code)} 2>/dev/null || echo null)"')
            if t.get("smoke") in SMOKE:
                b64 = base64.b64encode(SMOKE[t["smoke"]].encode()).decode()
                lines.append(f'if out="$(echo {b64} | base64 -d | {v}/bin/python - 2>&1)"; then echo "RLS {name} ok $(echo "$out" | tail -1)"; else echo "RLS {name} ng $(echo "$out" | tail -3 | tr "\\n" " ")"; fi')
        elif e["kind"] == "git":
            lines.append(f'echo "RLG {name} $(git -C {e["path"]} rev-parse HEAD 2>/dev/null || echo none)"')
    r = worker_exec(proj, "\n".join(lines) + "\n", capture=True)
    out = {}
    for line in (r.stdout or "").splitlines():
        if line[:4] in ("RLV ", "RLS ", "RLG "):
            tag, name, rest = line.split(" ", 2)
            out.setdefault(name, {})[tag] = rest
    ok = True
    for name, e in w.items():
        o = out.get(name, {})
        if e["kind"] == "py":
            try:
                have = json.loads(o.get("RLV", "null"))
            except json.JSONDecodeError:
                have = None
            local = (lock.get(name) or {}).get("packages")
            good = have == e.get("packages") and (local is None or have == local)
            msg = ", ".join(f"{k} {v}" for k, v in (have or {}).items()) if have else "venv が無い"
            if "RLS" in o:
                good &= o["RLS"].startswith("ok")
                msg += "｜" + o["RLS"][3:]
            if local is not None and have and have != local:
                msg += f"｜手元と違う {local}"
            print(f"{'✓' if good else '✗'} {name}（Worker）: {msg}")
        else:
            good = o.get("RLG") == e.get("commit")
            print(f"{'✓' if good else '✗'} {name}（Worker）: {o.get('RLG', '?')[:12]}")
        ok &= good
    if r.returncode != 0 and not out:
        print(f"✗ Worker に接続できないか、実行に失敗（終了コード {r.returncode}）\n{(r.stderr or '')[-600:]}"); return False
    return ok


def sim_run(proj: Path, cmd: list, worker: bool, venv_rel: str) -> int:
    if not cmd:
        die("実行するコマンドを -- のあとに書いてください（例: rl sim run --project P -- python -m src.x）")
    if not worker:
        venv = proj / venv_rel
        env = dict(os.environ, VIRTUAL_ENV=str(venv), PATH=f"{venv / 'bin'}:{os.environ.get('PATH', '')}")
        env.pop("PYTHONHOME", None)
        return subprocess.run(cmd, cwd=proj, env=env).returncode
    # プロジェクトの中の絶対パスは、Worker のミラーでの相対パスに読み替える
    cmd = [c.replace(str(proj) + "/", "") for c in cmd]
    body = f"""export VIRTUAL_ENV="$PWD/{venv_rel}"
export PATH="$VIRTUAL_ENV/bin:$PATH"
[ -x "$VIRTUAL_ENV/bin/python" ] || {{ echo "rl: Worker に {venv_rel} がありません（rl sim setup <tool> --project {proj.name} --worker）" >&2; exit 2; }}
{shlex.join(cmd)}
"""
    return worker_exec(proj, body).returncode


COLAB_NOTE = "試し用。ここで得た結果は論文に使わない（記録は rl run で）"


def colab_notebook(proj: Path, names: list, cat: dict, lock: dict) -> dict:
    def md(text):
        return {"cell_type": "markdown", "id": cid(), "metadata": {}, "source": text.splitlines(keepends=True)}

    def code(text):
        return {"cell_type": "code", "id": cid(), "metadata": {}, "execution_count": None, "outputs": [], "source": text.splitlines(keepends=True)}

    ncell = [0]

    def cid():
        ncell[0] += 1
        return f"rl-{ncell[0]:02d}"

    pins, gits, skipped, smokes, pyvers = [], [], [], [], set()
    for n in names:
        e = lock.get(n)
        if not e:
            die(f"{n} は sims.lock.yaml にありません（先に rl sim setup {n}）")
        if e["kind"] == "py":
            pins += [f"{k}=={v}" for k, v in (e.get("packages") or {}).items() if v]
            pyv = e.get("python") or py_version_of(lock_venv(proj, e) / "bin" / "python")
            if pyv:
                pyvers.add(pyv)
            if cat.get(n, {}).get("smoke") in SMOKE:
                smokes.append(n)
        elif e["kind"] == "git":
            gits.append((n, e["repo"], e["commit"]))
        else:
            skipped.append(f"{n}（{e['kind']}）")
    cells = [md(f"""# {proj.name}：Colab の環境

**{COLAB_NOTE}。**

- `rl sim colab` が `sims.lock.yaml` から作ったノートブック（{now()}）。版はプロジェクトの記録と同じものを入れる
- 道具: {', '.join(names)}""" + (f"\n- Colab には入れないもの: {', '.join(skipped)}（借りた GPU か手元で使う）" if skipped else "")
        + (f"\n- 記録の Python は {', '.join(sorted(pyvers))}" + ("（道具によって違う。Colab では 1 つの Python に全部入れる）" if len(pyvers) > 1 else "")
           + "。Colab の Python と違うと、同じ版の wheel が無いことがある（下のセルで表示する）" if pyvers else "")
        + "\n- ロボットのデータ（~/research-lab/.cache/robots）は Colab に上げない\n")]
    cells.append(code("import sys, platform\nprint('Python', platform.python_version())\n"
                      + (f"expected = {sorted(pyvers)!r}\nif not any(platform.python_version().startswith(v.rsplit('.', 1)[0]) for v in expected):\n    print('⚠ 記録の Python と違います:', expected)\n" if pyvers else "")))
    if pins:
        cells.append(code("%env MUJOCO_GL=egl\n" * any(p.startswith("mujoco") for p in pins)
                          + "!pip install -q " + " ".join(shlex.quote(p) for p in pins) + "\n"))
        want = {p.split("==")[0]: p.split("==")[1] for p in pins}
        cells.append(code(f"import importlib.metadata as m\nwant = {want!r}\nhave = {{k: m.version(k) for k in want}}\nbad = {{k: (v, have[k]) for k, v in want.items() if have[k] != v}}\nassert not bad, bad\nprint('版は記録と同じ:', have)\n"))
    for n, repo, commit in gits:
        cells.append(code(f"# {n} を記録の commit で取り込む\n!git init -q /content/{n} && cd /content/{n} && (git remote add origin {repo} 2>/dev/null || true) && git fetch -q --depth 1 origin {commit} && git checkout -q FETCH_HEAD && git rev-parse HEAD\n"))
    for n in smokes:
        cells.append(code(f"# 動作の確認: {n}\n" + SMOKE[cat[n]["smoke"]].lstrip()))
    return {"cells": cells, "metadata": {"colab": {"provenance": []}, "kernelspec": {"name": "python3", "display_name": "Python 3"},
                                          "language_info": {"name": "python"}, "rl": {"project": proj.name, "tools": names, "note": COLAB_NOTE}},
            "nbformat": 4, "nbformat_minor": 5}


def cmd_sim(a):
    cat = load_catalog()
    if a.scmd == "list":
        plat = this_platform()
        proj = None
        try:
            proj = resolve_project(a.project) if (a.project or (Path.cwd() / "research.yaml").exists()) else None
        except SystemExit:
            proj = None
        lock = load_sim_lock(proj) if proj else {}
        print(f"この計算機で動く: {', '.join(sorted(plat))}" + (f"   プロジェクト: {proj.name}" if proj else ""))
        for name, t in cat.items():
            here = "手元で可" if t.get("platform", "any") in plat and t.get("kind") != "remote" else ("借りた GPU" if t.get("kind") == "remote" else "この計算機では不可")
            inst = ""
            if name in lock:
                e = lock[name]
                inst = ("  [入っている " + (", ".join(f"{k} {v}" for k, v in (e.get("packages") or {}).items()) if e.get("kind") == "py"
                        else (e.get("commit", "")[:12] if e.get("kind") == "git" else (e.get("version") or e.get("template") or ""))) + "]")
            print(f"  {name:<12} {t.get('kind'):<6} {here:<10} {t.get('desc', '')}{inst}")
    elif a.scmd == "setup":
        proj = resolve_project(a.project)
        lock = load_sim_lock(proj)
        for name in a.tools:
            if name not in cat:
                die(f"一覧にない道具です: {name}（rl sim list）")
        if getattr(a, "worker", False):
            worker_setup(proj, a.tools, cat, lock)
            print(f"記録しました: {sim_lock_path(proj)}（worker:）")
            return
        for name in a.tools:
            sim_setup_one(proj, name, cat[name], lock)
        save_sim_lock(proj, lock)
        print(f"記録しました: {sim_lock_path(proj)}")
    elif a.scmd == "check":
        proj = resolve_project(a.project)
        lock = load_sim_lock(proj)
        if getattr(a, "worker", False):
            sys.exit(0 if worker_check(proj, cat, lock) else 1)
        if not lock:
            print("このプロジェクトには、まだ何も入っていません（rl sim setup <tool>）"); return
        ok = all([sim_check_one(proj, n, cat.get(n, {}), e) for n, e in lock.items()])
        sys.exit(0 if ok else 1)
    elif a.scmd == "run":
        proj = resolve_project(a.project)
        cmd = a.cmd_args[1:] if a.cmd_args[:1] == ["--"] else a.cmd_args
        venv_rel = ".venv"
        if a.tool:
            src = ((load_sim_lock_all(proj).get("worker") or {}).get("tools") or {}) if a.worker else load_sim_lock(proj)
            e = src.get(a.tool) or load_sim_lock(proj).get(a.tool)
            if not e:
                die(f"{a.tool} は sims.lock.yaml にありません")
            venv_rel = e.get("venv") or ".venv"
        sys.exit(sim_run(proj, cmd, a.worker, venv_rel))
    elif a.scmd == "colab":
        proj = resolve_project(a.project)
        lock = load_sim_lock(proj)
        names = a.tools or [n for n, e in lock.items() if e.get("kind") in ("py", "git")]
        nb = colab_notebook(proj, names, cat, lock)
        out = proj / "notebooks" / "colab_setup.ipynb"
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(json.dumps(nb, ensure_ascii=False, indent=1) + "\n")
        code = "import nbformat, sys; nbformat.validate(nbformat.read(sys.argv[1], as_version=4))"
        r = subprocess.run(["uv", "run", "--quiet", "--no-project", "--with", "nbformat>=5.9", "python", "-c", code, str(out)], capture_output=True, text=True)
        if r.returncode != 0:
            die(f"ノートブックの検証に失敗: {(r.stderr or r.stdout)[-600:]}")
        checked = "nbformat で検証済み"
        print(f"✓ {out.relative_to(proj)} を書きました（{len(nb['cells'])} セル、{checked}）。{COLAB_NOTE}")
    elif a.scmd == "launch":
        proj = resolve_project(a.project)
        lock = load_sim_lock(proj)
        if a.tool == "mujoco":
            if "mujoco" not in lock:
                die("mujoco が入っていません（rl sim setup mujoco）")
            model = a.model
            if model and not Path(model).exists():
                if "menagerie" not in lock:
                    die("モデル集が入っていません（rl sim setup menagerie）か、--model に XML のパスを渡す")
                base = Path(lock["menagerie"]["path"]) / model
                cand = [base / "scene.xml", base / f"{model}.xml"] + sorted(base.glob("*.xml"))
                found = [c for c in cand if c.exists()]
                if not found:
                    die(f"モデルが見つかりません: {base}")
                model = str(found[0])
            py = lock_venv(proj, lock["mujoco"]) / "bin" / "python"
            cmd = [str(py), "-m", "mujoco.viewer"] + ([f"--mjcf={model}"] if model else [])
            if a.dry_run:
                code = f"import mujoco; m=mujoco.MjModel.from_xml_path({model!r}); print('読み込み OK: 物体', m.nbody, '関節', m.njnt, 'アクチュエータ', m.nu)" if model else "import mujoco; print('mujoco', mujoco.__version__)"
                r = subprocess.run([str(py), "-c", code], capture_output=True, text=True)
                print(r.stdout.strip() or r.stderr.strip()[-600:])
                print("起動するときのコマンド: " + " ".join(cmd))
                return
            print("ビューアを起動します: " + " ".join(cmd))
            subprocess.run(cmd)
        elif a.tool in lock and lock[a.tool].get("kind") == "remote":
            e = lock[a.tool]
            print(f"{a.tool} は借りた GPU で動かします（G2 の承認のあと）：rl gpu up {proj.name} {e['template']} --hours H --usd-per-hour X")
        elif a.tool in lock and lock[a.tool].get("kind") == "git":
            print(f"{a.tool} は {lock[a.tool]['path']} にあります。起動の手順はその README と sims/catalog.yaml の build を見る")
        else:
            die(f"{a.tool} の起動は未対応か、まだ入っていません（rl sim list）")


# ---------------------------------------------------------------- doctor
def which(cmd):
    return shutil.which(cmd)


def cmd_doctor(a):
    ok = True
    def line(name, good, note=""):
        nonlocal ok
        ok &= bool(good)
        print(f"{'✓' if good else '✗'} {name}{('  — ' + note) if note else ''}")
    for c in ("git", "uv", "claude", "python3"):
        line(c, which(c))
    line("codex（査読役）", which("codex"), "brew install codex / codex login" if not which("codex") else "")
    line("ARIS codex MCP サーバー", (ARIS / "mcp-servers" / "codex-exec" / "server.py").exists())
    sky = which("sky")
    line("SkyPilot (sky)", sky, "" if sky else "rl sim setup skypilot --project <name>（または uv tool install 'skypilot[runpod,lambda]'）→ 認証は skills/gpu-cloud/SKILL.md")
    if sky and a.clouds:
        r = subprocess.run(["sky", "check", "runpod", "lambda"], capture_output=True, text=True)
        print(r.stdout[-1500:] or r.stderr[-1500:])
    for name in [p.name for p in (RL / "skills").iterdir() if (p / "SKILL.md").exists()]:
        link = CLAUDE_SKILLS / name
        line(f"skill {name}", link.exists(), "rl link で登録" if not link.exists() else "")
    line("rl コマンドが PATH にある", which("rl"), f"rl link で {LOCAL_BIN}/rl を作る" if not which("rl") else "")
    _, cpath = load_config()
    print(f"{'✓' if cpath.name == 'config.yaml' else '·'} 手元の設定: "
          + (str(cpath) if cpath.name == "config.yaml" else "config.yaml がないので例の値を使用（cp config.example.yaml config.yaml）"))
    sys.exit(0 if ok else 1)


# ---------------------------------------------------------------- config
def cmd_config(a):
    cfg, path = load_config()
    if a.key:
        v = cfg_get(cfg, a.key, None)
        if v is None:
            die(f"設定にありません: {a.key}")
        if isinstance(v, (dict, list)):
            YAML().dump(v, sys.stdout)
        else:
            print(os.path.expanduser(str(v)) if str(v).startswith("~") else v)
        return
    note = "" if path.name == "config.yaml" else "  ← config.yaml がないので例の値。cp config.example.yaml config.yaml で作る"
    print(f"# {path}{note}")
    YAML().dump(cfg, sys.stdout)


# ---------------------------------------------------------------- link
def cmd_link(a):
    CLAUDE_SKILLS.mkdir(parents=True, exist_ok=True)
    for p in sorted((RL / "skills").iterdir()):
        if not (p / "SKILL.md").exists():
            continue
        dst = CLAUDE_SKILLS / p.name
        if dst.is_symlink() or dst.exists():
            if dst.is_symlink() and dst.resolve() == p.resolve():
                print(f"= {p.name}")
                continue
            print(f"! {p.name}: {dst} が既にあるので飛ばしました（中身を確認してください）")
            continue
        dst.symlink_to(p)
        print(f"+ {p.name} → {p}")
    LOCAL_BIN.mkdir(parents=True, exist_ok=True)
    rl_link = LOCAL_BIN / "rl"
    if not rl_link.exists():
        rl_link.symlink_to(RL / "bin" / "rl")
        print(f"+ {rl_link}")


# ---------------------------------------------------------------- sync
def cmd_sync(a):
    subprocess.run([str(RL / "scripts" / "vendor-sync.sh"), *a.names], check=True)
    subprocess.run([sys.executable, str(RL / "scripts" / "build-index.py")], check=True)


# ---------------------------------------------------------------- night
NIGHT_ALLOWED = [
    "Read", "Edit", "Write", "Glob", "Grep", "WebSearch", "WebFetch", "TodoWrite", "Skill",
    "mcp__codex__codex", "mcp__codex__codex-reply",
    "Bash(python3:*)", "Bash(python:*)", "Bash(uv:*)", "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)",
    "Bash(wc:*)", "Bash(grep:*)", "Bash(find:*)", "Bash(mkdir:*)", "Bash(cp:*)", "Bash(mv:*)",
    "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)", "Bash(git commit:*)",
    "Bash(git rev-parse:*)", "Bash(ssh:*)", "Bash(rsync:*)", "Bash(scp:*)",
    "Bash(rl status:*)", "Bash(rl check:*)", "Bash(rl gpu:*)", "Bash(sky status:*)", "Bash(sky logs:*)", "Bash(sky queue:*)",
    "Bash(sky exec:*)", "Bash(latexmk:*)", "Bash(pdflatex:*)", "Bash(bibtex:*)",
]
NIGHT_DENIED = [
    "Bash(git push:*)", "Bash(rm -rf:*)", "Bash(sky launch:*)", "Bash(sky down:*)",
    "Bash(lerobot-record:*)", "Bash(lerobot-teleoperate:*)", "Bash(lerobot-replay:*)",
    "Bash(curl:*)", "Bash(gh:*)",
]


def ledger_snapshot(proj: Path):
    led = load(proj / "research.yaml")
    pend = [g for g, v in (led.get("gates") or {}).items() if v.get("pending")]
    blockers = len(led.get("blockers") or [])
    open_tasks = [t for t in (led.get("tasks") or []) if t.get("status") in ("open", "doing")]
    return led, pend, blockers, open_tasks


def cmd_night(a):
    proj = resolve_project(a.project)
    lock = proj / ".night.lock"
    try:
        fd = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        os.write(fd, str(os.getpid()).encode())
        os.close(fd)
    except FileExistsError:
        die(f"夜間ループが既に動いています（{lock}）。止まっているなら消してください")
    outdir = proj / ".night" / dt.datetime.now().strftime("%Y%m%d-%H%M")
    outdir.mkdir(parents=True, exist_ok=True)
    prompt = (RL / "templates" / "night-prompt.md").read_text()
    deadline = time.time() + a.hours * 3600
    spent = 0.0
    summary = [f"# 夜間ループ {outdir.name}", f"上限: {a.iterations} 回 / ${a.budget_usd} / {a.hours}h", ""]
    reason = "回数の上限"
    try:
        _, pend0, blockers0, _ = ledger_snapshot(proj)
        if pend0:
            reason = f"開始前から人の判断待ち: {pend0}"
            a.iterations = 0
        for i in range(1, a.iterations + 1):
            remaining = a.budget_usd - spent
            if remaining < 0.5:
                reason = "費用の上限"
                break
            if time.time() > deadline:
                reason = "時間の上限"
                break
            per_iter = min(a.per_iter_usd, remaining)
            gates_before = {g: bool(v.get("approved")) for g, v in (load(proj / "research.yaml").get("gates") or {}).items()}
            cmd = ["claude", "-p", prompt, "--output-format", "json", "--permission-mode", "dontAsk",
                   "--max-budget-usd", f"{per_iter:.2f}",
                   "--allowedTools", *NIGHT_ALLOWED, "--disallowedTools", *NIGHT_DENIED]
            t0 = time.time()
            try:
                r = subprocess.run(cmd, cwd=proj, capture_output=True, text=True, env={**os.environ, "RL_NIGHT": "1"},
                                   timeout=min(a.iter_minutes * 60, max(60, deadline - time.time())))
                out = r.stdout
            except subprocess.TimeoutExpired as e:
                out = (e.stdout or b"").decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
                out += "\n[rl night] この回は時間切れで打ち切り"
            (outdir / f"iter-{i:02d}.log").write_text(out)
            cost, result = 0.0, ""
            try:
                j = json.loads(out.strip().splitlines()[-1]) if out.strip() else {}
                cost = float(j.get("total_cost_usd") or 0)
                result = (j.get("result") or "")[:600]
            except (json.JSONDecodeError, ValueError, IndexError):
                result = out[-600:]
            spent += cost
            summary += [f"## {i}回目（{(time.time() - t0) / 60:.0f} 分・${cost:.2f}）", result, ""]
            # GPU の消し忘れ防止
            subprocess.run([str(RL / "bin" / "rl"), "gpu", "reap"], capture_output=True)
            if ledger_errors(proj):
                reason = "台帳が壊れた（rl check で確認）"
                break
            led = load(proj / "research.yaml")
            flipped = [g for g, v in (led.get("gates") or {}).items() if v.get("approved") and not gates_before.get(g)]
            if flipped:
                for g in flipped:
                    led["gates"][g]["approved"] = False
                led.setdefault("blockers", []).append({"at": now(), "reason": f"夜間ループが {flipped} を承認に変えたので戻した（承認は人だけ）", "needs": "human"})
                dump(led, proj / "research.yaml")
                reason = f"ゲートの無断承認を検知して戻した: {flipped}"
                break
            led, pend, blockers, open_tasks = ledger_snapshot(proj)
            if pend:
                reason = f"人の判断待ち: {pend}"
                break
            if blockers > blockers0:
                reason = "blocker が増えた"
                break
            if not open_tasks:
                reason = "未完了のタスクがない"
                break
        led = load(proj / "research.yaml")
        add_log(led, "night-loop", f"{outdir.name}: 終了（{reason}）、費用 ${spent:.2f}")
        dump(led, proj / "research.yaml")
    finally:
        lock.unlink(missing_ok=True)
        summary.insert(2, f"**終了理由: {reason}**　合計 ${spent:.2f}")
        (outdir / "summary.md").write_text("\n".join(summary))
    print(f"終了: {reason}  合計 ${spent:.2f}  → {outdir / 'summary.md'}")


# ---------------------------------------------------------------- gpu
def save_clusters(proj: Path, data):
    (proj / ".gpu").mkdir(exist_ok=True)
    (proj / ".gpu" / "clusters.json").write_text(json.dumps(data, indent=1, ensure_ascii=False))


def cmd_gpu_up(a):
    if not which("sky"):
        die("SkyPilot がありません: uv tool install 'skypilot[runpod,lambda]'")
    proj = resolve_project(a.project)
    led = load(proj / "research.yaml")
    if not (led.get("gates") or {}).get("G2", {}).get("approved"):
        die("G2（計画と予算の承認）が済んでいません。GPU は承認後に立てます")
    b = led.get("budget") or {}
    if a.hours > float(b.get("max_run_hours") or 0):
        die(f"--hours {a.hours} が 1 回の上限 {b.get('max_run_hours')}h を超えています")
    data, up = active_clusters(proj)
    committed = sum(c["usd_per_hour"] * c["max_hours"] for c in up)
    est = a.usd_per_hour * a.hours
    remaining = float(b.get("gpu_usd") or 0) - float(b.get("gpu_usd_spent") or 0) - committed
    if est > remaining:
        die(f"予算が足りません: 見積もり ${est:.2f} > 残り ${remaining:.2f}（稼働中の分を差し引き済み）")
    if float(b.get("gpu_usd_spent") or 0) + committed + est > 0.8 * float(b.get("gpu_usd") or 0):
        if os.environ.get("RL_NIGHT") == "1":
            die("この実行で GPU 予算の 80% を超えます。夜間ループでは立てません（blockers に書いて止まってください）")
        print("⚠ この実行で GPU 予算の 80% を超えます", file=sys.stderr)
    cluster = a.cluster or f"rl-{led.get('project')}-{dt.datetime.now().strftime('%m%d%H%M')}"[:40]
    cmd = ["sky", "launch", "-y", "-c", cluster, "--down", "-i", str(a.idle), "--env", f"MAX_HOURS={a.hours}", a.task]
    print(" ".join(cmd), flush=True)
    entry = {"cluster": cluster, "task": a.task, "usd_per_hour": a.usd_per_hour, "max_hours": a.hours,
             "started_ts": time.time(), "started": now(), "state": "up"}
    data.append(entry)
    save_clusters(proj, data)  # 先に記録（launch が途中で落ちても reap で拾う）
    r = subprocess.run(cmd, cwd=proj)
    if r.returncode != 0:
        print("sky launch が失敗しました。残っていれば reap で消します", file=sys.stderr)
    add_log(led, "rl gpu", f"up {cluster} {a.task} ≤{a.hours}h ${a.usd_per_hour}/h")
    dump(led, proj / "research.yaml")
    print(f"SSH: ssh {cluster}   作業ディレクトリ: ~/sky_workdir")


def _down(proj: Path, cluster: str, why: str):
    subprocess.run(["sky", "down", "-y", cluster])
    data, _ = active_clusters(proj)
    led = load(proj / "research.yaml")
    for c in data:
        if c["cluster"] == cluster and c.get("state") == "up":
            hours = min((time.time() - c["started_ts"]) / 3600, c["max_hours"] + 0.25)
            c.update(state="down", ended=now(), hours=round(hours, 3), usd=round(hours * c["usd_per_hour"], 2))
            b = led.setdefault("budget", {})
            b["gpu_usd_spent"] = round(float(b.get("gpu_usd_spent") or 0) + c["usd"], 2)
            add_log(led, "rl gpu", f"down {cluster}（{why}）{c['hours']}h ${c['usd']}（概算）")
    save_clusters(proj, data)
    dump(led, proj / "research.yaml")


def cmd_gpu_down(a):
    _down(resolve_project(a.project), a.cluster, "手動")


def all_projects():
    for p in PROJECTS.glob("*/research.yaml"):
        yield p.parent
    extra = RL / ".cache" / "external-projects.txt"
    if extra.exists():
        for line in extra.read_text().splitlines():
            if line.strip() and (Path(line) / "research.yaml").exists():
                yield Path(line)


def cmd_gpu_reap(a):
    for proj in all_projects():
        _, up = active_clusters(proj)
        for c in up:
            if (time.time() - c["started_ts"]) / 3600 > c["max_hours"]:
                print(f"上限時間を過ぎたので消します: {c['cluster']}（{proj.name}）")
                _down(proj, c["cluster"], "上限時間")


def cmd_gpu_status(a):
    for proj in all_projects():
        _, up = active_clusters(proj)
        for c in up:
            el = (time.time() - c["started_ts"]) / 3600
            print(f"{proj.name}\t{c['cluster']}\t{el:.1f}h/{c['max_hours']}h\t${c['usd_per_hour']}/h")
    if which("sky"):
        subprocess.run(["sky", "status"])


# ---------------------------------------------------------------- main
def plugin_commands() -> dict:
    """bin/rl-<name> を rl <name> として呼べるようにする（git と同じ仕組み）。"""
    out = {}
    for f in sorted((RL / "bin").glob("rl-*")):
        if f.is_file() and os.access(f, os.X_OK):
            out[f.name[3:]] = f
    return out


def main():
    plugins = plugin_commands()
    if len(sys.argv) > 1 and sys.argv[1] in plugins:
        os.execv(str(plugins[sys.argv[1]]), [str(plugins[sys.argv[1]])] + sys.argv[2:])
    doc = __doc__
    if plugins:
        doc += "\n追加のコマンド（bin/rl-<name>）: " + ", ".join(sorted(plugins)) + "\n"
    ap = argparse.ArgumentParser(prog="rl", description=doc, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("new"); p.add_argument("name"); p.add_argument("--domain", default="ml"); p.add_argument("--path")
    p.add_argument("--program", help="紐づけるプログラム名"); p.add_argument("--paper", help="プログラムの論文 ID（P1 など）")
    p.set_defaults(fn=cmd_new)
    p = sub.add_parser("status"); p.add_argument("project", nargs="?"); p.set_defaults(fn=cmd_status)
    p = sub.add_parser("check"); p.add_argument("project", nargs="?"); p.set_defaults(fn=cmd_check)
    sm = sub.add_parser("sim", help="シミュレーターと道具（sims/catalog.yaml）").add_subparsers(dest="scmd", required=True)
    q = sm.add_parser("list"); q.add_argument("--project"); q.set_defaults(fn=cmd_sim)
    q = sm.add_parser("setup"); q.add_argument("tools", nargs="+"); q.add_argument("--project")
    q.add_argument("--worker", action="store_true", help="dev-worker（offload）のプロジェクトのミラーに、手元の lock と同じ版を入れる"); q.set_defaults(fn=cmd_sim)
    q = sm.add_parser("check"); q.add_argument("--project"); q.add_argument("--worker", action="store_true", help="dev-worker 側を確かめる"); q.set_defaults(fn=cmd_sim)
    q = sm.add_parser("run", help="プロジェクトの .venv でコマンドを実行（--worker なら dev-worker で）"); q.add_argument("--project")
    q.add_argument("--worker", action="store_true"); q.add_argument("--tool", help="その道具の venv を使う（別の Python の道具、例 drake）")
    q.add_argument("cmd_args", nargs=argparse.REMAINDER); q.set_defaults(fn=cmd_sim)
    q = sm.add_parser("colab", help="sims.lock.yaml の版を入れる Colab のノートブックを書く（試し用）"); q.add_argument("tools", nargs="*"); q.add_argument("--project")
    q.set_defaults(fn=cmd_sim)
    q = sm.add_parser("launch"); q.add_argument("tool"); q.add_argument("--model", help="モデル集の名前（例 universal_robots_ur5e）か XML のパス")
    q.add_argument("--project"); q.add_argument("--dry-run", action="store_true", help="起動せず、読み込めるかだけ確かめる"); q.set_defaults(fn=cmd_sim)
    pg = sub.add_parser("program", help="研究プログラム（系統・論文の並び）とプロジェクトの紐づけ").add_subparsers(dest="pcmd", required=True)
    q = pg.add_parser("new"); q.add_argument("name"); q.set_defaults(fn=cmd_program)
    q = pg.add_parser("list"); q.set_defaults(fn=cmd_program)
    q = pg.add_parser("status"); q.add_argument("name", nargs="?"); q.set_defaults(fn=cmd_program)
    q = pg.add_parser("link"); q.add_argument("program"); q.add_argument("paper_id"); q.add_argument("project"); q.set_defaults(fn=cmd_program)
    q = pg.add_parser("readme"); q.add_argument("name", nargs="?"); q.set_defaults(fn=cmd_program)
    q = pg.add_parser("check"); q.add_argument("name", nargs="?"); q.set_defaults(fn=cmd_program)
    p = sub.add_parser("readme", help="README の「検証状況」を台帳から書き直す"); p.add_argument("project", nargs="?")
    p.add_argument("--check", action="store_true", help="書き直さず、合っていなければ終了コード 1"); p.set_defaults(fn=cmd_readme)
    p = sub.add_parser("doctor"); p.add_argument("--clouds", action="store_true"); p.set_defaults(fn=cmd_doctor)
    p = sub.add_parser("link"); p.set_defaults(fn=cmd_link)
    p = sub.add_parser("config", help="手元の設定（記録先・ロボット・計算環境）を表示"); p.add_argument("key", nargs="?", help="例: robot.repo")
    p.set_defaults(fn=cmd_config)
    p = sub.add_parser("sync"); p.add_argument("names", nargs="*"); p.set_defaults(fn=cmd_sync)
    p = sub.add_parser("night"); p.add_argument("project", nargs="?")
    p.add_argument("--iterations", type=int, default=20); p.add_argument("--budget-usd", type=float)
    p.add_argument("--per-iter-usd", type=float, default=3.0); p.add_argument("--iter-minutes", type=int, default=90)
    p.add_argument("--hours", type=float, default=8); p.set_defaults(fn=cmd_night)
    g = sub.add_parser("gpu").add_subparsers(dest="gcmd", required=True)
    p = g.add_parser("up"); p.add_argument("project"); p.add_argument("task")
    p.add_argument("--hours", type=float, required=True); p.add_argument("--usd-per-hour", type=float, required=True)
    p.add_argument("--idle", type=int, default=30); p.add_argument("--cluster"); p.set_defaults(fn=cmd_gpu_up)
    p = g.add_parser("down"); p.add_argument("project"); p.add_argument("cluster"); p.set_defaults(fn=cmd_gpu_down)
    p = g.add_parser("reap"); p.set_defaults(fn=cmd_gpu_reap)
    p = g.add_parser("status"); p.set_defaults(fn=cmd_gpu_status)
    a = ap.parse_args()
    if a.cmd == "night" and a.budget_usd is None:
        led = load(resolve_project(a.project) / "research.yaml")
        a.budget_usd = float((led.get("budget") or {}).get("llm_usd_per_night") or 10)
    a.fn(a)


if __name__ == "__main__":
    main()
