#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["ruamel.yaml>=0.18"]
# ///
"""rl — research-lab の操作コマンド

  rl new <name> [--domain ml|cv|nlp|robotics|systems] [--path DIR]   研究プロジェクトを作る
  rl status [name|path]                                               台帳の要約
  rl check [name|path]                                                台帳の書式の確認
  rl readme [name|path] [--check]                                     README の「検証状況」を台帳から書き直す
  rl program new <name> / list / status [name] / link <program> <paper_id> <project> / readme [name]
                                                                      研究プログラム（系統・論文の並び）とプロジェクトの紐づけ
  rl sim list / setup <tool..> / check / launch <tool> [--model M]   シミュレーターと道具（sims/catalog.yaml）をプロジェクトに入れる・確かめる・起動する
  rl sim setup/check --worker / run [--worker] [--tool T] -- <cmd> / colab [tool..]   dev-worker に同じ版を入れる・そこで実行する・Colab のノートブックを書く
  rl doctor [--clouds]                                                ツール・接続の確認
  rl link                                                             スキルを ~/.claude/skills に登録
  rl sync                                                             上流スキルの更新と索引の再生成
  rl night <name|path> [--iterations N] [--budget-usd X] [--hours H]  夜間ループ
  rl gpu up <name|path> <task.yaml> --hours H --usd-per-hour X [--idle M] [--cluster C]
  rl gpu down <name|path> <cluster>
  rl gpu reap                                                         上限時間を過ぎた GPU を消す
  rl gpu status
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

from ruamel.yaml import YAML

RL = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(RL / "lib"))   # rlkit（追加のコマンドと共有する部品）
PROJECTS = RL / "projects"
PROGRAMS = RL / "programs"
ARIS = RL / "vendor" / "aris"
CLAUDE_SKILLS = Path.home() / ".claude" / "skills"
LOCAL_BIN = Path.home() / ".local" / "bin"

# 研究プロジェクトの .claude/skills/ に登録する ARIS のスキル（研究の主な流れで使うもの）
ARIS_CORE = """
research-pipeline idea-discovery idea-discovery-robot idea-creator novelty-check kill-argument
research-lit arxiv semantic-scholar openalex alphaxiv research-review research-refine
research-refine-pipeline experiment-plan ablation-planner experiment-bridge research-implement-feature
run-experiment experiment-queue monitor-experiment training-check analyze-results result-to-claim
experiment-audit integrity-forensics auto-review-loop auto-paper-improvement-loop paper-plan
paper-write paper-writing paper-figure paper-compile paper-claim-audit citation-audit
citation-crosscheck formula-derivation proof-checker writing-systems-papers paper-slides
paper-poster-html mermaid-diagram rebuttal resubmit-pipeline research-wiki system-profile
""".split()

DOMAINS = ["ml", "cv", "nlp", "robotics", "systems"]

yaml = YAML()
yaml.preserve_quotes = True
yaml.width = 4096
yaml.indent(mapping=2, sequence=4, offset=2)   # テンプレートと同じ「  - 」の書式で書き出す


def now() -> str:
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def die(msg: str) -> None:
    print(f"rl: {msg}", file=sys.stderr)
    sys.exit(1)


def resolve_project(ref: str | None) -> Path:
    if ref is None:
        p = Path.cwd()
        while p != p.parent:
            if (p / "research.yaml").exists():
                return p
            p = p.parent
        die("研究プロジェクトの中で実行するか、名前かパスを指定してください")
    cand = Path(ref).expanduser()
    if (cand / "research.yaml").exists():
        return cand.resolve()
    if (PROJECTS / ref / "research.yaml").exists():
        return PROJECTS / ref
    die(f"プロジェクトが見つかりません: {ref}")


def load(path: Path):
    with path.open() as f:
        return yaml.load(f)


def dump(data, path: Path) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    with tmp.open("w") as f:
        yaml.dump(data, f)
    tmp.replace(path)


def load_config() -> tuple[dict, Path]:
    """手元の設定。config.yaml がなければ config.example.yaml（例の値）を使う。"""
    for name in ("config.yaml", "config.example.yaml"):
        p = RL / name
        if p.exists():
            with p.open() as f:
                return (YAML(typ="safe").load(f) or {}), p
    return {}, RL / "config.yaml"


def cfg_get(cfg: dict, dotted: str, default=""):
    cur = cfg
    for k in dotted.split("."):
        if not isinstance(cur, dict) or k not in cur:
            return default
        cur = cur[k]
    return cur if cur is not None else default


def local_section(cfg: dict) -> str:
    lines = [f"- {cfg_get(cfg, 'compute.local', '手元のマシン: 小さな確認・シミュレーション・図')}"]
    host, off = cfg_get(cfg, "compute.worker_host"), cfg_get(cfg, "compute.offload")
    if host and off:
        lines.append(f"- 重い CPU 処理は `{off} <cmd>` で {host} へ")
    elif host:
        lines.append(f"- 重い CPU 処理は `ssh {host}` で回す")
    return "\n".join(lines)


def add_log(led, by: str, what: str) -> None:
    if led.get("log") is None:
        led["log"] = []
    led["log"].append({"at": now(), "by": by, "what": what})


# ---------------------------------------------------------------- new
def cmd_new(a):
    if a.domain not in DOMAINS:
        die(f"--domain は {DOMAINS} のどれか")
    target = Path(a.path).expanduser() / a.name if a.path else PROJECTS / a.name
    if target.exists():
        die(f"すでにあります: {target}")
    shutil.copytree(RL / "templates" / "project", target)
    cfg, _ = load_config()
    for f in target.rglob("*"):
        if f.is_file() and f.suffix in {".md", ".yaml", ".json", ".gitignore"} or f.name == ".gitignore":
            s = f.read_text()
            s = (s.replace("{{PROJECT}}", a.name).replace("{{DOMAIN}}", a.domain)
                  .replace("{{DATE}}", dt.date.today().isoformat()).replace("{{RL}}", str(RL))
                  .replace("{{LOCAL}}", local_section(cfg)))
            f.write_text(s)
    # ARIS の主要スキルをプロジェクトに登録（相対参照のため shared-references も）
    sk = target / ".claude" / "skills"
    sk.mkdir(parents=True, exist_ok=True)
    missing = []
    for name in ARIS_CORE + ["shared-references"]:
        src = ARIS / "skills" / name
        if src.exists():
            (sk / name).symlink_to(src)
        else:
            missing.append(name)
    settings = {"env": {"ARIS_REPO": str(ARIS), "RL_HOME": str(RL)}}
    (target / ".claude" / "settings.json").write_text(json.dumps(settings, indent=2) + "\n")
    mcp = {"mcpServers": {"codex": {"command": "python3", "args": [str(ARIS / "mcp-servers" / "codex-exec" / "server.py")]}}}
    (target / ".mcp.json").write_text(json.dumps(mcp, indent=2) + "\n")
    for d in ("runs", "src", "configs", "paper", "notes", ".gpu"):
        (target / d).mkdir(exist_ok=True)
    subprocess.run(["git", "init", "-q", "-b", "main"], cwd=target, check=True)
    _, readme, _ = readme_state(target)
    (target / "README.md").write_text(readme)
    print(f"作成しました: {target}")
    if getattr(a, "program", None):
        if not a.paper:
            print("  ⚠ --program には --paper も要ります。紐づけは `rl program link` で")
        elif a.path:
            print("  ⚠ --path で projects/ の外に作ったので、プログラムへの紐づけはしていません")
        else:
            link_paper(resolve_program(a.program), a.paper, a.name)
            _, readme, _ = readme_state(target)
            (target / "README.md").write_text(readme)
    print(f"  ARIS スキル {len(ARIS_CORE) - len(missing)} 個をプロジェクトに登録" + (f"（見つからない: {missing}）" if missing else ""))
    print("  次: cd して Claude Code を開き「research-lab で S1 から始めて」と頼む")


# ---------------------------------------------------------------- status
def count_runs(proj: Path):
    from rlkit.runs import test_runs   # test の数え方は rl run と同じ（失敗・中断した test 実行も数える）
    runs = sorted((proj / "runs").glob("run_*"))
    by = {}
    for r in runs:
        st = (r / "status").read_text().strip() if (r / "status").exists() else "?"
        by[st] = by.get(st, 0) + 1
    return runs, by, len(test_runs(proj))


def active_clusters(proj: Path):
    f = proj / ".gpu" / "clusters.json"
    data = json.loads(f.read_text()) if f.exists() else []
    return data, [c for c in data if c.get("state") == "up"]


def cmd_status(a):
    proj = resolve_project(a.project)
    led = load(proj / "research.yaml")
    print(f"# {led.get('project')}  ({led.get('domain')})  stage={led.get('stage')}")
    if led.get("question"):
        print(f"問い: {led['question']}")
    pgm = led.get("program") or {}
    if pgm.get("name"):
        print(f"プログラム: {pgm.get('name')} / {pgm.get('paper_id')}" + (f"（依存: {', '.join(pgm.get('depends_on') or [])}）" if pgm.get("depends_on") else ""))
    gates = led.get("gates") or {}
    print("ゲート: " + "  ".join(
        f"{g}:{'✓' if v.get('approved') else ('待ち' if v.get('pending') else '-')}" for g, v in gates.items()))
    b = led.get("budget") or {}
    print(f"GPU 予算: ${b.get('gpu_usd_spent', 0)} / ${b.get('gpu_usd', 0)}   1 回の上限: {b.get('max_run_hours')}h")
    runs, by, test_evals = count_runs(proj)
    print(f"実行: {len(runs)} 件 {by}   test での評価: {test_evals} 回")
    _, up = active_clusters(proj)
    for c in up:
        el = (time.time() - c["started_ts"]) / 3600
        print(f"GPU 稼働中: {c['cluster']}  {el:.1f}h / 上限 {c['max_hours']}h  ${c['usd_per_hour']}/h")
    tasks = [t for t in (led.get("tasks") or []) if t.get("status") != "done"]
    print(f"未完了のタスク: {len(tasks)}")
    for t in tasks[:8]:
        print(f"  - [{t.get('status')}] {t.get('id')} {t.get('title')}")
    for bl in led.get("blockers") or []:
        print(f"⚠ blocker: {bl.get('reason')}  (needs: {bl.get('needs')})")
    claims = proj / "claims.yaml"
    if claims.exists():
        cl = load(claims).get("claims") or []
        st = {}
        for c in cl:
            st[c.get("status")] = st.get(c.get("status"), 0) + 1
        print(f"主張: {st}")


# ---------------------------------------------------------------- check
def ledger_errors(proj: Path) -> list[str]:
    errs = []
    try:
        led = load(proj / "research.yaml")
    except Exception as e:  # noqa: BLE001
        return [f"research.yaml が読めません: {e}"]
    for k in ("project", "stage", "gates", "budget", "protocol", "tasks", "blockers", "log"):
        if k not in led:
            errs.append(f"research.yaml に {k} がありません")
    if str(led.get("stage")) not in [f"S{i}" for i in range(8)]:
        errs.append(f"stage が S0〜S7 ではありません: {led.get('stage')}")
    for g in ("G1", "G2", "G3", "G4"):
        if g not in (led.get("gates") or {}):
            errs.append(f"gates に {g} がありません")
    ids = [t.get("id") for t in (led.get("tasks") or [])]
    if len(ids) != len(set(ids)):
        errs.append("tasks の id が重複しています")
    for t in led.get("tasks") or []:
        if t.get("status") not in ("open", "doing", "done", "blocked"):
            errs.append(f"{t.get('id')}: status が不正 {t.get('status')}")
        for d in t.get("depends_on") or []:
            if d not in ids:
                errs.append(f"{t.get('id')}: depends_on の {d} がありません")
    errs += project_program_errors(proj, led)
    cf = proj / "claims.yaml"
    if cf.exists():
        try:
            cl = load(cf) or {}
        except Exception as e:  # noqa: BLE001
            return errs + [f"claims.yaml が読めません: {e}"]
        for c in cl.get("claims") or []:
            for r in c.get("evidence") or []:
                if not (proj / "runs" / r).exists():
                    errs.append(f"{c.get('id')}: 証拠の {r} が runs/ にありません")
            if c.get("status") == "frozen" and not (led.get("gates") or {}).get("G3", {}).get("approved"):
                errs.append(f"{c.get('id')}: G3 の承認前に frozen になっています")
    return errs


def cmd_check(a):
    proj = resolve_project(a.project)
    errs = ledger_errors(proj)
    pr = RL / "bin" / "rl-prereg"
    if pr.exists() and subprocess.run([str(pr), "check", str(proj), "--quiet"]).returncode != 0:
        errs.append("事前登録が凍結時から変わっています（上の rl prereg check の表示）")
    for e in errs:
        print(f"✗ {e}")
    print("✓ 台帳は正しく読めます" if not errs else f"{len(errs)} 件の問題")
    if not errs:
        _, _, state = readme_state(proj)
        if state != "ok":
            print("⚠ README の検証状況が台帳と合っていません（`rl readme` で直す）")
    sys.exit(1 if errs else 0)


# ---------------------------------------------------------------- readme
AUTO_START, AUTO_END = "<!-- rl:auto:start -->", "<!-- rl:auto:end -->"
STAGE_NAMES = {"S-1": "興味・テーマ", "S0": "準備", "S1": "アイデア・文献", "S2": "計画", "S3": "実験",
               "S4": "分析・主張", "S5": "執筆", "S6": "自己査読", "S7": "査読対応"}
STRENGTH = {"strong": "言い切る", "qualified": "限定つき", "exploratory": "探索的"}
CLAIM_STATUS = {"candidate": "候補", "frozen": "確定（G3）", "retracted": "取り下げ"}


def _cell(x) -> str:
    return str(x if x is not None else "").replace("|", "\\|").replace("\n", " ").strip()


def render_auto(proj: Path) -> str:
    """README の「検証状況」の枠の中身。台帳にあることだけを書く（数字は claims.yaml と runs/ から）。"""
    led = load(proj / "research.yaml")
    out = [f"_台帳（research.yaml・claims.yaml・runs/）から `rl readme` が生成。最終更新 {dt.date.today().isoformat()}_", ""]
    st = str(led.get("stage"))
    out.append(f"- **段階**：{st} {STAGE_NAMES.get(st, '')}")
    gl = []
    for g, v in (led.get("gates") or {}).items():
        mark = "✓" if v.get("approved") else ("判断待ち" if v.get("pending") else "-")
        when = f"（{v.get('decided_at')}）" if v.get("approved") and v.get("decided_at") else ""
        gl.append(f"{g} {mark}{when}")
    out.append("- **確認ポイント**：" + " / ".join(gl))
    if led.get("venue_target"):
        out.append(f"- **投稿先の目安**：{_cell(led['venue_target'])}")
    pgm = led.get("program") or {}
    if pgm.get("name"):
        out.append(f"- **プログラム**：{_cell(pgm.get('name'))} の {_cell(pgm.get('paper_id'))}" + (f"（依存：{', '.join(pgm.get('depends_on') or [])}）" if pgm.get("depends_on") else ""))
    out += ["", "**研究の問い**", "", f"> {_cell(led.get('question')) or '（未確定。G1 で決める）'}", "", "**仮説**", ""]
    hyps = led.get("hypotheses") or []
    out += [f"- {_cell(h)}" for h in hyps] or ["（まだない。S2 で反証できる形に書き、G2 で確定する）"]
    out += ["", "**主張と証拠**", ""]
    cl = []
    if (proj / "claims.yaml").exists():
        cl = (load(proj / "claims.yaml") or {}).get("claims") or []
    live = [c for c in cl if c.get("status") != "retracted"]
    if live:
        out += ["| ID | 主張 | 強さ | 証拠の種類 | 状態 | 証拠（run） |", "|---|---|---|---|---|---|"]
        for c in live:
            ev = c.get("evidence") or []
            out.append(f"| {_cell(c.get('id'))} | {_cell(c.get('text'))} | {STRENGTH.get(c.get('strength'), _cell(c.get('strength')))} "
                       f"| {_cell(c.get('eval_type'))} | {CLAIM_STATUS.get(c.get('status'), _cell(c.get('status')))} | {len(ev)} 件 |")
    else:
        out.append("（まだない。主張は claims.yaml に証拠の run_id とともに置く）")
    if len(cl) > len(live):
        out.append(f"\n取り下げた主張：{len(cl) - len(live)} 件（claims.yaml に記録）")
    runs, by, test_evals = count_runs(proj)
    mx = (led.get("protocol") or {}).get("max_test_evals")
    out += ["", f"- **実行**：{len(runs)} 件" + (f"（{', '.join(f'{k} {v}' for k, v in by.items())}）" if by else "")
            + f"。テストセットでの評価 {test_evals} 回" + (f" / 上限 {mx} 回" if mx else "")]
    tasks = [t for t in (led.get("tasks") or []) if t.get("status") != "done"]
    if tasks:
        out += ["", "**次にやること**", ""]
        for t in tasks[:6]:
            title = _cell(t.get("title"))
            out.append(f"- {t.get('id')}：{title[:110] + '…' if len(title) > 110 else title}")
        if len(tasks) > 6:
            out.append(f"- ほか {len(tasks) - 6} 件（`rl status`）")
    bl = led.get("blockers") or []
    if bl:
        out += ["", "**止まっている理由**", ""] + [f"- {_cell(b.get('reason'))}（要るもの：{b.get('needs')}）" for b in bl]
    return "\n".join(out)


def _strip_date(block: str) -> str:
    return "\n".join(l for l in block.splitlines() if "最終更新" not in l)


def readme_state(proj: Path):
    """(README の本文, 新しい本文, 状態) 状態は ok | stale | no-markers | missing。"""
    f = proj / "README.md"
    new_block = render_auto(proj)
    if not f.exists():
        return "", f"# {proj.name}\n\n## 検証状況\n{AUTO_START}\n{new_block}\n{AUTO_END}\n", "missing"
    s = f.read_text()
    if AUTO_START not in s or AUTO_END not in s:
        return s, s.rstrip("\n") + f"\n\n## 検証状況\n{AUTO_START}\n{new_block}\n{AUTO_END}\n", "no-markers"
    head, rest = s.split(AUTO_START, 1)
    old_block, tail = rest.split(AUTO_END, 1)
    if _strip_date(old_block.strip("\n")) == _strip_date(new_block):
        return s, s, "ok"
    return s, f"{head}{AUTO_START}\n{new_block}\n{AUTO_END}{tail}", "stale"


def cmd_readme(a):
    proj = resolve_project(a.project)
    old, new, state = readme_state(proj)
    msg = {"ok": "README の検証状況は台帳と一致しています", "stale": "README の検証状況が台帳と食い違っています",
           "no-markers": "README に自動の枠（rl:auto）がありません", "missing": "README.md がありません"}[state]
    if a.check:
        print(("✓ " if state == "ok" else "✗ ") + msg)
        sys.exit(0 if state == "ok" else 1)
    if state == "ok":
        print("✓ " + msg)
        return
    (proj / "README.md").write_text(new)
    print(f"{msg} → 書き直しました: {proj / 'README.md'}")
    if state in ("missing", "no-markers"):
        print("  手で書く欄（一言・目的と狙い・先行研究との差分・方法の骨格）は templates/project/README.md を参考に足す")


# ---------------------------------------------------------------- program
PAPER_STATUS = ("planned", "active", "done", "dropped")
LINE_STATUS = ("active", "later", "paused", "dropped")


def resolve_program(ref: str | None) -> Path:
    """名前かパスからプログラムのフォルダを返す。省略時は、いまいるプロジェクトの紐づけから探す。"""
    if ref is None:
        p = Path.cwd()
        while p != p.parent:
            if (p / "program.yaml").exists():
                return p
            if (p / "research.yaml").exists():
                name = ((load(p / "research.yaml").get("program") or {}).get("name"))
                if name and (PROGRAMS / name / "program.yaml").exists():
                    return PROGRAMS / name
                break
            p = p.parent
        die("プログラムの名前を指定してください（rl program list で一覧）")
    cand = Path(ref).expanduser()
    if (cand / "program.yaml").exists():
        return cand.resolve()
    if (PROGRAMS / ref / "program.yaml").exists():
        return PROGRAMS / ref
    die(f"プログラムが見つかりません: {ref}")


def project_dir(name: str | None):
    if not name:
        return None
    p = PROJECTS / str(name)
    return p if (p / "research.yaml").exists() else None


def find_paper(prog_data, paper_id):
    for pp in prog_data.get("papers") or []:
        if str(pp.get("id")) == str(paper_id):
            return pp
    return None


def paper_state(pp, prog_data):
    """論文 1 本の状態（紐づいたプロジェクトの台帳から）。"""
    proj = project_dir(pp.get("project"))
    st = {"stage": "-", "gates": "-", "open": "-", "blockers": 0, "linked": bool(proj)}
    if proj:
        led = load(proj / "research.yaml")
        st["stage"] = str(led.get("stage"))
        gates = led.get("gates") or {}
        st["gates"] = " ".join(f"{g}{'✓' if v.get('approved') else ('…' if v.get('pending') else '-')}" for g, v in gates.items())
        st["open"] = len([t for t in (led.get("tasks") or []) if t.get("status") != "done"])
        st["blockers"] = len(led.get("blockers") or [])
    deps = pp.get("depends_on") or []
    waiting = []
    for d in deps:
        dp = find_paper(prog_data, d)
        if dp is None or dp.get("status") != "done":
            waiting.append(str(d))
    st["waiting_on"] = waiting
    return st


def program_errors(prog: Path) -> list[str]:
    errs = []
    try:
        data = load(prog / "program.yaml")
    except Exception as e:  # noqa: BLE001
        return [f"program.yaml が読めません: {e}"]
    line_ids = [str(l.get("id")) for l in (data.get("lines") or [])]
    if len(line_ids) != len(set(line_ids)):
        errs.append("lines の id が重複しています")
    for l in data.get("lines") or []:
        if l.get("status") not in LINE_STATUS:
            errs.append(f"系統 {l.get('id')}: status が不正 {l.get('status')}（{'/'.join(LINE_STATUS)}）")
    ids = [str(pp.get("id")) for pp in (data.get("papers") or [])]
    if len(ids) != len(set(ids)):
        errs.append("papers の id が重複しています")
    for pp in data.get("papers") or []:
        pid = pp.get("id")
        if str(pp.get("line")) not in line_ids:
            errs.append(f"{pid}: line {pp.get('line')} が lines にありません")
        if pp.get("status") not in PAPER_STATUS:
            errs.append(f"{pid}: status が不正 {pp.get('status')}（{'/'.join(PAPER_STATUS)}）")
        for d in pp.get("depends_on") or []:
            if str(d) not in ids:
                errs.append(f"{pid}: depends_on の {d} が papers にありません")
        if pp.get("project"):
            proj = project_dir(pp.get("project"))
            if not proj:
                errs.append(f"{pid}: project {pp.get('project')} が projects/ にありません")
            else:
                pg = load(proj / "research.yaml").get("program") or {}
                if pg.get("name") != data.get("program") or str(pg.get("paper_id")) != str(pid):
                    errs.append(f"{pid}: {pp.get('project')} の research.yaml の program 欄が合っていません（rl program link で直す）")
    return errs


def project_program_errors(proj: Path, led) -> list[str]:
    """プロジェクト側から見た紐づけの確認（rl check で使う）。"""
    pg = led.get("program") or {}
    if not pg:
        return []
    if pg.get("file") and not pg.get("name"):
        return ["program.file は古い書き方です。`rl program link <program> <paper_id> <project>` で紐づけ直す"]
    name, pid = pg.get("name"), pg.get("paper_id")
    if not name:
        return []
    prog = PROGRAMS / str(name)
    if not (prog / "program.yaml").exists():
        return [f"program {name} が programs/ にありません"]
    pp = find_paper(load(prog / "program.yaml"), pid)
    if pp is None:
        return [f"program {name} に論文 {pid} がありません"]
    if str(pp.get("project")) != proj.name:
        return [f"program {name} の {pid} は project {pp.get('project')} を指しています（このプロジェクトは {proj.name}）"]
    return []


def link_paper(prog: Path, paper_id: str, project: str) -> None:
    data = load(prog / "program.yaml")
    pp = find_paper(data, paper_id)
    if pp is None:
        die(f"{prog.name} に論文 {paper_id} がありません（program.yaml の papers に足してから）")
    proj = project_dir(project)
    if not proj:
        die(f"プロジェクトが見つかりません: {project}")
    # 別の論文が同じプロジェクトを指していたら外す（1 論文 = 1 プロジェクト）
    for other in data.get("papers") or []:
        if other is not pp and other.get("project") == project:
            die(f"{project} はすでに {other.get('id')} に紐づいています")
    pp["project"] = project
    if pp.get("status") == "planned":
        pp["status"] = "active"
    dump(data, prog / "program.yaml")
    led = load(proj / "research.yaml")
    deps = [find_paper(data, d) for d in (pp.get("depends_on") or [])]
    led["program"] = {"name": data.get("program"), "paper_id": str(paper_id),
                      "depends_on": [d.get("project") for d in deps if d and d.get("project")]}
    add_log(led, "rl", f"rl program link で {data.get('program')} の {paper_id} に紐づけ")
    dump(led, proj / "research.yaml")
    print(f"紐づけました: {data.get('program')} / {paper_id} ↔ {project}")


def render_program_auto(prog: Path) -> str:
    data = load(prog / "program.yaml")
    out = [f"_program.yaml と各プロジェクトの台帳から `rl program readme` が生成。最終更新 {dt.date.today().isoformat()}_", ""]
    for l in data.get("lines") or []:
        out.append(f"**系統 {l.get('id')}：{_cell(l.get('name'))}**（{l.get('status')}）")
        if l.get("trunk"):
            out.append(f"> {_cell(l.get('trunk'))}")
        out.append("")
        papers = [pp for pp in (data.get("papers") or []) if str(pp.get("line")) == str(l.get("id"))]
        if not papers:
            out += ["（論文はまだない）", ""]
            continue
        out += ["| ID | 問い | 状態 | プロジェクト | 段階 | 確認ポイント | 未完了 | 依存 |", "|---|---|---|---|---|---|---|---|"]
        for pp in papers:
            st = paper_state(pp, data)
            dep = ", ".join(str(d) for d in (pp.get("depends_on") or [])) or "—"
            if st["waiting_on"]:
                dep += "（待ち：" + ", ".join(st["waiting_on"]) + "）"
            out.append(f"| {_cell(pp.get('id'))} | {_cell(pp.get('question'))} | {pp.get('status')} | {_cell(pp.get('project')) or '—'} "
                       f"| {st['stage']} | {st['gates']} | {st['open']} | {dep} |")
        out.append("")
    return "\n".join(out).rstrip() + "\n"


def cmd_program(a):
    if a.pcmd == "new":
        target = PROGRAMS / a.name
        if target.exists():
            die(f"すでにあります: {target}")
        shutil.copytree(RL / "templates" / "program", target)
        for f in target.rglob("*"):
            if f.is_file():
                f.write_text(f.read_text().replace("{{PROGRAM}}", a.name).replace("{{DATE}}", dt.date.today().isoformat()))
        subprocess.run(["git", "init", "-q", "-b", "main"], cwd=target, check=True)
        print(f"作成しました: {target}（program.md に全体像、program.yaml に系統と論文の対応を書く）")
    elif a.pcmd == "list":
        progs = sorted(d for d in PROGRAMS.glob("*") if (d / "program.yaml").exists()) if PROGRAMS.exists() else []
        if not progs:
            print("プログラムはまだありません（rl program new <name>）")
        for d in progs:
            data = load(d / "program.yaml")
            papers = data.get("papers") or []
            linked = len([pp for pp in papers if pp.get("project")])
            print(f"{d.name:<24} {_cell(data.get('title'))}  系統 {len(data.get('lines') or [])}・論文 {len(papers)}（プロジェクトあり {linked}）")
    elif a.pcmd == "status":
        prog = resolve_program(a.name)
        data = load(prog / "program.yaml")
        print(f"# {data.get('program')}  {_cell(data.get('title'))}")
        for l in data.get("lines") or []:
            print(f"\n系統 {l.get('id')} {l.get('name')}  [{l.get('status')}]")
            if l.get("trunk"):
                print(f"  幹: {l.get('trunk')}")
            for pp in [pp for pp in (data.get("papers") or []) if str(pp.get("line")) == str(l.get("id"))]:
                st = paper_state(pp, data)
                proj = pp.get("project") or "（プロジェクト未作成）"
                extra = f"  stage={st['stage']}  {st['gates']}  未完了 {st['open']}" if st["linked"] else ""
                warn = f"  ⚠ blocker {st['blockers']}" if st["blockers"] else ""
                wait = f"  依存の待ち: {', '.join(st['waiting_on'])}" if st["waiting_on"] else ""
                print(f"  - {pp.get('id'):<4} [{pp.get('status')}] {proj}{extra}{warn}{wait}")
                if pp.get("question"):
                    print(f"         {pp.get('question')}")
        errs = program_errors(prog)
        for e in errs:
            print(f"✗ {e}")
    elif a.pcmd == "link":
        link_paper(resolve_program(a.program), a.paper_id, a.project)
    elif a.pcmd == "readme":
        prog = resolve_program(a.name)
        f = prog / "program.md"
        block = render_program_auto(prog)
        s = f.read_text() if f.exists() else f"# プログラム：{prog.name}\n"
        if AUTO_START in s and AUTO_END in s:
            head, rest = s.split(AUTO_START, 1)
            _, tail = rest.split(AUTO_END, 1)
            s = f"{head}{AUTO_START}\n{block}{AUTO_END}{tail}"
        else:
            s = s.rstrip("\n") + f"\n\n## 論文とプロジェクトの状況\n{AUTO_START}\n{block}{AUTO_END}\n"
        f.write_text(s)
        print(f"書き直しました: {f}")
    elif a.pcmd == "check":
        prog = resolve_program(a.name)
        errs = program_errors(prog)
        for e in errs:
            print(f"✗ {e}")
        print("✓ プログラムの台帳は正しく読めます" if not errs else f"{len(errs)} 件の問題")
        sys.exit(1 if errs else 0)


# ---------------------------------------------------------------- sim
