def obj(m, t):
    bvh = fcl.BVHModel(); bvh.beginModel(len(m.vertices), len(m.faces)); bvh.addSubModel(m.vertices, m.faces); bvh.endModel()
    return fcl.CollisionObject(bvh, fcl.Transform(np.eye(3), np.array(t, float)))
